{
  "name": "electron-effect-rpc",
  "version": "1.0.0",
  "description": "Effect RPC transport for Electron: RpcServer and RpcClient over MessagePorts between main, renderer and utility processes",
  "keywords": [
    "effect",
    "electron",
    "ipc",
    "messageport",
    "rpc",
    "utility-process"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joaoeira/electron-effect-rpc.git"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./main": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    },
    "./renderer": {
      "types": "./dist/renderer.d.ts",
      "default": "./dist/renderer.js"
    },
    "./preload": {
      "types": "./dist/preload.d.ts",
      "default": "./dist/preload.js"
    },
    "./utility": {
      "types": "./dist/utility.d.ts",
      "default": "./dist/utility.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "test:electron": "bun test-electron/run.ts",
    "test:types": "tsc -p tsconfig.test.json",
    "test:packaging": "bash ./scripts/run-packaging-checks.sh",
    "test:full": "bun run test:types && bun test && bun run test:electron && bun run test:packaging",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check ."
  },
  "devDependencies": {
    "@oxlint/plugins": "1.78.0",
    "@types/node": "^22.0.0",
    "bun-types": "^1.1.0",
    "effect": "^4.0.0-rc.118",
    "electron": "^38.0.0",
    "fast-check": "4.9.0",
    "oxfmt": "^0.34.0",
    "oxlint": "1.78.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "effect": "^4.0.0-rc.118",
    "electron": ">=30.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
